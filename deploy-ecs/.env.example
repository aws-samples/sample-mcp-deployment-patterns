# ECS Deployment Configuration
STACK_NAME=maths-mcp-ecs
REGION=us-west-2
CLUSTER_NAME=maths-mcp-cluster
SERVICE_NAME=maths-mcp-service
TASK_FAMILY=maths-mcp-task

# Container Configuration
CONTAINER_NAME=maths-mcp-container
IMAGE_NAME=maths-mcp-server
ECR_REPOSITORY=maths-mcp-server
CONTAINER_PORT=8000

# Task Configuration
DESIRED_COUNT=1
CPU=256
MEMORY=512

# Cognito Configuration
USER_POOL_NAME=maths-mcp-users-ecs
APP_CLIENT_NAME=maths-mcp-client-ecs

# Cognito User Credentials for Testing
COGNITO_USERNAME=your-email@example.com
COGNITO_PASSWORD=YourSecurePassword123!

# Cognito Configuration (from CloudFormation deployment)
COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=your-region

# API Gateway URL for MCP endpoint (with Cognito authentication)
API_GATEWAY_URL=https://your-api-id.execute-api.region.amazonaws.com
# ALB URL for direct access (HTTP only)
ALB_URL=http://your-alb-dns-name.region.elb.amazonaws.com/mcp