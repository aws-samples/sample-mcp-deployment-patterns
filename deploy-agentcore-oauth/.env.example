# Cognito Configuration
# Copy this file to .env and fill in your actual credentials
COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=your-region

# Cognito User Credentials
COGNITO_USERNAME=your-email@example.com
COGNITO_PASSWORD=YourSecurePassword123!

# AgentCore Configuration
AGENT_NAME=your_agent_name_oauth
REGION=your-region

# OAuth Configuration
OAUTH_DISCOVERY_URL=https://cognito-idp.your-region.amazonaws.com/your-region_XXXXXXXXX/.well-known/openid-configuration
