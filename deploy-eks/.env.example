# EKS Deployment Configuration
CLUSTER_NAME=maths-mcp-eks
REGION=us-west-2
NAMESPACE=mcp-server

# Container Configuration
IMAGE_NAME=maths-mcp-server
ECR_REPOSITORY=maths-mcp-server
CONTAINER_PORT=8000

# Deployment Configuration
REPLICAS=2
CPU_REQUEST=100m
CPU_LIMIT=500m
MEMORY_REQUEST=128Mi
MEMORY_LIMIT=512Mi

# Private ALB TLS configuration
ACM_CERTIFICATE_ARN=arn:aws:acm:us-west-2:123456789012:certificate/replace-me
INTERNAL_ALB_SERVER_NAME=mcp.internal.example.com

# Auto-configured by deployment scripts (do not edit manually)
VPC_ID=
ECR_URI=
INTERNAL_ALB_URL=
API_GATEWAY_URL=
